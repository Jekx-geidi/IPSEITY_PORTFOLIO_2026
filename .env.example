# OPENROUTER_API_KEY: powers the Ask BMO chat (api/chat.ts).
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"

# GITHUB_TOKEN: optional; raises the GitHub API rate limit for the live projects list (api/_github.ts).
GITHUB_TOKEN="MY_GITHUB_TOKEN"

# "Where is Jake now?" (api/where.ts): Upstash Redis from the Vercel Marketplace sets the two KV_ vars.
KV_REST_API_URL="MY_UPSTASH_REST_URL"
KV_REST_API_TOKEN="MY_UPSTASH_REST_TOKEN"
# LOCATION_SECRET: any long random string; Jake's phone sends it when checking in.
LOCATION_SECRET="MY_LOCATION_SECRET"
